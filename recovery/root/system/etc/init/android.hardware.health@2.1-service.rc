# SPDX-License-Identifier: MIT
service health-hal-2-1 /twrp_vendor/bin/hw/android.hardware.health@2.1-service
    class hal charger
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /twrp_vendor/lib64:/twrp_vendor/lib64/hw
    setenv LD_CONFIG_FILE /twrp_vendor/etc/ld.config.liuqin.txt
