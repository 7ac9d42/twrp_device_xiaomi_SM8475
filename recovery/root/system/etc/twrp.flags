/boot emmc /dev/block/bootdevice/by-name/boot flags=backup=1;slotselect;flashimg=1
/recovery emmc /dev/block/bootdevice/by-name/recovery flags=backup=1;slotselect;flashimg=1
/vendor_boot emmc /dev/block/bootdevice/by-name/vendor_boot flags=backup=1;slotselect;flashimg=1
/dtbo emmc /dev/block/bootdevice/by-name/dtbo flags=backup=1;slotselect;flashimg=1
/vbmeta emmc /dev/block/bootdevice/by-name/vbmeta flags=backup=1;slotselect;flashimg=1
/vbmeta_system emmc /dev/block/bootdevice/by-name/vbmeta_system flags=backup=1;slotselect;flashimg=1
/data f2fs /dev/block/bootdevice/by-name/userdata flags=display="Data";backup=1
/metadata ext4 /dev/block/bootdevice/by-name/metadata flags=display="Metadata";backup=1
/usb_otg auto /dev/block/sda1 /dev/block/sda flags=display="USB-OTG";storage;removable;wipeingui
