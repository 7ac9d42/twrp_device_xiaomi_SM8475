# SPDX-License-Identifier: Apache-2.0
# Pin ramdisk vendor files before TWRP temporarily mounts the real vendor partition.
on early-init
    mkdir /twrp_vendor 0755 root root
    mount none /vendor /twrp_vendor bind
    mount none none /twrp_vendor private

on init
    start boot-hal-1-2

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mkdir /mnt/vendor 0775 root system
    mkdir /mnt/vendor/persist 0775 root system
    wait /dev/block/bootdevice/by-name/persist
    mount ext4 /dev/block/bootdevice/by-name/persist /persist noatime nosuid nodev
    mount none /persist /mnt/vendor/persist bind
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion

on property:vendor.sys.listeners.registered=true
    start vendor.keymaster-4-1
    start vendor.keymint-qti
    start gatekeeper-1-0

on property:twrp.modules.loaded=true
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    wait /sys/kernel/boot_adsp/boot 10
    write /sys/kernel/boot_adsp/boot 1
    start vendor.qseecomd
    start health-hal-2-1

on boot
    setprop sys.usb.config adb
