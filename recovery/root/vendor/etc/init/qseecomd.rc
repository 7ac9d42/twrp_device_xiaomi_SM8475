# SPDX-License-Identifier: MIT
service vendor.qseecomd /twrp_vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /twrp_vendor/lib64:/twrp_vendor/lib64/hw
    setenv LD_CONFIG_FILE /twrp_vendor/etc/ld.config.liuqin.txt
