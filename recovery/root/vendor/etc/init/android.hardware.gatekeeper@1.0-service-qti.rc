# SPDX-License-Identifier: MIT
service gatekeeper-1-0 /twrp_vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /twrp_vendor/lib64:/twrp_vendor/lib64/hw
    setenv LD_CONFIG_FILE /twrp_vendor/etc/ld.config.liuqin.txt
